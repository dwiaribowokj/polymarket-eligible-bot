# polymarket-eligible-bot - salin ke .env, lalu chmod 600 .env
# Eligible live berbasis aturan; tidak memerlukan model AI atau Docker.
# Prioritas konfigurasi: shell > .env proyek > konfigurasi eligible privat
# > POLYMARKET_ENV_FILE. Nilai kosong tetap menimpa sumber prioritas lebih rendah.
# Bila wallet disimpan di file privat, hapus baris kosong wallet/CLOB di .env.
# Template ini untuk instalasi baru; jangan timpa konfigurasi live yang ada.

# Polygon chain 137. RPC utama dan cadangan harus berbeda.
POLYGON_RPC_URL=https://polygon-bor-rpc.publicnode.com
POLYGON_RPC_BACKUP_URL=https://polygon.drpc.org

# EOA penanda tangan (private key 0x..., bukan seed phrase).
# Wallet pendanaan Polymarket menyimpan pUSD; EOA signer memerlukan POL
# untuk gas redeem dan penarikan. POL dan pUSD merupakan saldo terpisah.
PRIVATE_KEY=
PROXY_WALLET_ADDRESS=

# Opsional: isi ketiganya, atau kosongkan ketiganya untuk derivasi dari signer.
CLOB_API_KEY=
CLOB_API_SECRET=
CLOB_API_PASSPHRASE=

# Live terus mengevaluasi entry setelah win/loss; drawdown 10 pUSD hanya
# peringatan. Saldo cukup, validitas data, dan rekonsiliasi tetap wajib lulus.
# Service continuous restart otomatis setelah crash; aktivasi awal tetap manual.
ELIGIBLE_CONTINUOUS_TRADING=true

# Biaya full-fill 5 shares, termasuk fee + estimasi gas, maksimal 0.82/share (pilihan: 0.82 atau 0.85).
# Filter cost-cap dan buffer tidak boleh aktif bersamaan.
ELIGIBLE_ENTRY_COST_CAP=true
ELIGIBLE_ENTRY_COST_CAP_MAX=0.82
ELIGIBLE_ENTRY_BUFFER=false
# Veto fail-closed dari spot Binance btcusdt@bookTicker: tolak entry jika bergerak berlawanan
# >= 2 bps dalam 5 detik terakhir, feed belum siap, atau stale > 3 detik (butuh cost-cap aktif,
# tidak boleh bersamaan dengan ELIGIBLE_ENTRY_BUFFER=true).
ELIGIBLE_ENTRY_BINANCE_LEAD_VETO=true
# Estimasi gas USD untuk evaluasi biaya entry, bukan saldo POL atau harga gas RPC.
RESTART_PAPER_GAS_USD=0.05

# Penarikan opsional melalui Bridge resmi: pUSD -> native USDC di Polygon.
# Nama LAYA_PROFIT_* dipertahankan karena masih dibaca runtime; bukan pemakaian AI.
# Isi EOA penerima milik sendiri, lalu ubah ENABLED menjadi true untuk mengaktifkan.
# Master switch false menonaktifkan seluruh penarikan, termasuk aturan setelah loss.
LAYA_PROFIT_TAKING_ENABLED=false
LAYA_PROFIT_RECIPIENT=
LAYA_PROFIT_TRIGGER=wallet_balance
LAYA_PROFIT_LOSS_PROTECTION_ENABLED=true
# Normal: saldo wallet terverifikasi >=15 pUSD, tarik 5 bruto, sisakan >=10.
# Setelah loss: saldo sebelum trade >=14 dan sesudah loss >10, tarik 5 bruto.
# Aturan setelah loss boleh menyisakan <10 pUSD; live berlanjut setelah rekonsiliasi.
# Deposit dapat memicu aturan saldo normal, tetapi tidak dihitung sebagai profit.
# Batas biaya Bridge 0.05 USD dan gas penarikan 0.15 USD; rute/biaya harus terverifikasi.

# Opsional: konfigurasi privat default ~/.config/polymarket-eligible-live.env.
# Path eksplisit harus absolut. Simpan file privat dengan chmod 600.
# ELIGIBLE_LIVE_CONFIG=/absolute/private/path/eligible-live.env
# POLYMARKET_ENV_FILE=/absolute/private/path/wallet.env

# Default ledger: data/restart di repo. Wallet lama wajib memakai seluruh ledger
# privat yang sama, termasuk riwayat periode, stop, dan penarikan.
# Perubahan strategi/profit pada wallet lama memerlukan migrasi, bukan reset data.
# RESTART_DATA_DIR=/absolute/private/path/restart

# Node.js 24. ./scripts/poly config|check|start|stop|status|logs
# check memeriksa kesiapan; start mengaktifkan live menggunakan saldo wallet.
# Opsional dari shell: POLYMARKET_NODE=/absolute/path/to/node
