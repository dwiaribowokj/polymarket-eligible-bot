[Unit]
Description=Polymarket Laya paper rehearsal (virtual funds only)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/polymarket-eligible-bot
EnvironmentFile=-%h/.config/polymarket-ai-shadow.env
ExecStart=/usr/bin/node scripts/laya-pilot.js paper
Restart=on-failure
RestartSec=15
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
