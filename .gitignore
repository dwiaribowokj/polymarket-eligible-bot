# Local backups and exported snapshots
*.bak
*.backup
*.old
*.tmp
*.swp
*.zip
*.tar
*.tar.gz
/release/
/releases/

# Operational incident notes contain personal wallet/transaction information.
# Keep only portable setup and reference documentation in the new repository.
/docs/*
!/docs/setup.md
!/docs/reference.md
